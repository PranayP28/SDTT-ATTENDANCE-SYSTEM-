# ─────────────────────────────────────────────────────────────
#  Classroom Attendance – Backend Environment Variables
#  Copy this file to .env and fill in your values.
#  NEVER commit the real .env file to version control.
# ─────────────────────────────────────────────────────────────

# ── Supabase ─────────────────────────────────────────────────
# Find these in: Supabase Dashboard → Project Settings → API

# Your project URL (e.g. https://xyzxyzxyz.supabase.co)
SUPABASE_URL=https://your-project-id.supabase.co

# "anon" public key (safe for client SDKs)
SUPABASE_ANON_KEY=your-anon-key-here

# "service_role" secret key (NEVER expose this to clients – backend only)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# JWT secret for verifying Supabase-issued tokens
# Find in: Supabase Dashboard → Project Settings → API → JWT Secret
SUPABASE_JWT_SECRET=your-jwt-secret-here

# ── Application ───────────────────────────────────────────────
ATTENDANCE_ENV=development

# Token / WebSocket settings
ATTENDANCE_TOKEN_TTL_SECONDS=28800
ATTENDANCE_WS_TICKET_TTL_SECONDS=60
ATTENDANCE_MAX_CAPTURE_BYTES=10485760

# Allowed CORS origins (comma-separated)
ATTENDANCE_CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8081

# ── Biometrics & Security ─────────────────────────────────────
# Secret used to derive the biometric template encryption key and sign liveness
# challenge tokens (alias: ATTENDANCE_SECRET_KEY, which wins if both are set).
# Use a random value of at least 32 characters, e.g. generated via: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
ATTENDANCE_BIOMETRIC_ENCRYPTION_KEY=

# ── Continuous Sweep Verification Thresholds ──────────────────
ATTENDANCE_MIN_FRAMES=12
ATTENDANCE_SWEEP_MIN_DURATION_S=4.0
ATTENDANCE_SWEEP_MAX_DURATION_S=15.0
ATTENDANCE_HEADING_MIN_SPAN_DEG=150.0
ATTENDANCE_HEADING_MAX_GAP_DEG=25.0
ATTENDANCE_MIN_LAPLACIAN_VAR=100.0
ATTENDANCE_MIN_LUMINANCE=40.0
ATTENDANCE_MAX_LUMINANCE=220.0
ATTENDANCE_SIMILARITY_PASS=0.72
ATTENDANCE_SIMILARITY_FLAG=0.50
ATTENDANCE_MIN_NEIGHBOURS=1
ATTENDANCE_LECTURER_MIN_IPD_PX=30.0
ATTENDANCE_SESSION_GRACE_PERIOD_S=5.0
ATTENDANCE_FILMSTRIP_RETENTION_DAYS=7

